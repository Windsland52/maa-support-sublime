{
  "name": "maa-support-sublime",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint && pnpm python:lint",
    "python:lint": "uv run --frozen ruff check pkgs/sublime scripts/sublime_ui_runner.py",
    "python:format": "uv run --frozen ruff format pkgs/sublime scripts/sublime_ui_runner.py",
    "test": "pnpm -r --if-present test && node --test test/*.test.mjs && uv run --frozen python -B -m unittest pkgs/sublime/test_plugin.py",
    "test:sublime-ui": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/test-sublime-ui.ps1",
    "package:sublime": "pnpm build && node scripts/build-package.mjs",
    "package-tag:sublime": "node scripts/publish-package-tag.mjs",
    "release:sublime": "pnpm test && node scripts/build-package.mjs"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.3.5",
    "jszip": "^3.10.1",
    "prettier": "^3.8.1",
    "tsdown": "0.21.0",
    "typescript": "^5.9.3"
  }
}
