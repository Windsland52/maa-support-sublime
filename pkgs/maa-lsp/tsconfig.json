{
  "extends": ["@tsconfig/node24/tsconfig.json"],
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["@types/node"],
    "noEmit": true,
    "strict": true
  },
  "include": ["src/**/*.ts"]
}
